spec_version "1.0"

project "Test Derived"
version "1.0"

INPUT:
    source orders

OUTPUT:
    source validated_orders

IMPLEMENTATION:
    stage validate:
        input orders
        output validated_orders
        use contract
        schema:
            order_id is integer
            price is float
            quantity is integer
            total is float
        require:
            price > 0
            quantity between 1 and 100
            total > 0
        derive:
            total = price * quantity